{
    "workbench.colorTheme": "Default Dark+",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
        }
    },
    "workbench.startupEditor": "welcomePage",
    "security.workspace.trust.enabled": false,
    "http.proxySupport": "on",
    "http.proxyStrictSSL": false,
    "websocket.timeout": 86400,
    "developer.websocket.retries": 5,
    "developer.websocket.useWss": false,
    "flake8.enabled": true,
    "flake8.args": [
        "--max-line-length=120",
        "--ignore=E128,E123,E226"
    ],
    "python.formatter.provider": "black",
    "black-formatter.args": [
        "--line-length=120"
    ],
    "editor.formatOnSave": false,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.terminal.activateEnvInCurrentTerminal": true,
    // editor 관련 설정
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.defaultFormatter": "esbenp.prettier-code-formatter",
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // 마크다운 관련 설정
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "markdownFormatter.formatOpt": {
        "indent": 4
    },
    "markdown.extension.list.indentationSize": 4,
    "markdown-preview-enhanced.plantumlServer": "https://kroki.io/plantuml/svg/",
    "markdown.extension.toc.orderedList": true,
    "markdown.extension.toc.omittedFromToc": {
        ".md": [
            "# 목차"
        ]
    }
}