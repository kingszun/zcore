# RUN curl -L "https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && \
#     chmod +x /usr/local/bin/docker-compose

# # Install Docker Machine for managing Docker hosts
# RUN curl -L https://github.com/docker/machine/releases/download/v0.16.2/docker-machine-$(uname -s)-$(uname -m) -o /usr/local/bin/docker-machine && \
#     chmod +x /usr/local/bin/docker-machine

# # Install Docker-in-Docker (DinD) support
# RUN apt-get install -y \
#     iptables \
#     ca-certificates \
#     curl \
#     gnupg \
#     lsb-release && \
#     mkdir -p /etc/apt/keyrings && \
#     curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
#     echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
#     apt-get update && \
#     apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# # Install NVIDIA Docker runtime for GPU support in nested containers
# RUN distribution=$(. /etc/os-release;echo $ID$VERSION_ID) && \
#     curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg && \
#     curl -s -L https://nvidia.github.io/libnvidia-container/$distribution/libnvidia-container.list | \
#     sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
#     tee /etc/apt/sources.list.d/nvidia-container-toolkit.list && \
#     apt-get update && \
#     apt-get install -y nvidia-container-toolkit

# Install nvm and Node.js for krong user
ENV NVM_DIR=${USER_HOME}/.nvm
RUN mkdir -p ${NVM_DIR} && \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install --lts && \
    nvm use --lts && \
    nvm alias default node && \
    chown -R krong:krong ${NVM_DIR}

RUN cat << 'EOF' >> /etc/bash.bashrc

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

EOF

# Install Claude CLI for krong user
RUN su - krong -c "curl -fsSL https://claude.ai/install.sh | bash -s latest"
RUN git clone https://github.com/SuperClaude-Org/SuperClaude_Framework.git /opt/SuperClaude_Framework && \
    chown -R krong:krong /opt/SuperClaude_Framework
RUN git clone https://github.com/fuergaosi233/claude-code-proxy.git /opt/claude-code-proxy && \
    cd /opt/claude-code-proxy && \
    chown -R krong:krong /opt/claude-code-proxy && \
    su - krong -c "cd /opt/claude-code-proxy && uv sync"
RUN . "$NVM_DIR/nvm.sh" && npm install -g @musistudio/claude-code-router

# Add Claude alias to krong's bashrc
RUN cat << 'EOF' >> ${USER_HOME}/.bashrc

# Claude
alias claude='IS_SANDBOX=1 claude --dangerously-skip-permissions'

EOF

# add git safe directory for krong user
RUN su - krong -c "git config --global --add safe.directory '*'"

# plant uml jar
COPY --chown=krong:krong infra/plantuml_jar/plantuml-1.2025.8.jar ${USER_HOME}/plantuml.jar

# =============================================================================
# Bash Configuration
# =============================================================================
# Enable bash completion for better CLI experience
RUN echo '# enable programmable completion features (you don'"'"'t need to enable' >> /etc/bash.bashrc && \
echo '# this, if it'"'"'s already enabled in /etc/bash.bashrc and /etc/profile' >> /etc/bash.bashrc && \
echo '# sources /etc/bash.bashrc).' >> /etc/bash.bashrc && \
echo 'if ! shopt -oq posix; then' >> /etc/bash.bashrc && \
echo '  if [ -f /usr/share/bash-completion/bash_completion ]; then' >> /etc/bash.bashrc && \
echo '    . /usr/share/bash-completion/bash_completion' >> /etc/bash.bashrc && \
echo '  elif [ -f /etc/bash_completion ]; then' >> /etc/bash.bashrc && \
echo '    . /etc/bash_completion' >> /etc/bash.bashrc && \
echo '  fi' >> /etc/bash.bashrc && \
echo 'fi' >> /etc/bash.bashrc

# Install tmux bash completion
RUN curl -fSsL "https://raw.githubusercontent.com/imomaliev/tmux-bash-completion/master/completions/tmux" -o /opt/.tmux-completion.bash && \
    echo "source /opt/.tmux-completion.bash" >> /etc/bash.bashrc
COPY --chown=krong:krong infra/docker/tmux/tmux.conf ${USER_HOME}/.tmux.conf

# =============================================================================
# Python Development Environment Setup
# =============================================================================
# Install dependencies for pyenv and Python development
RUN apt-get install -y --no-install-recommends \
        lsb-release \
        build-essential \
        libssl-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        wget \
        curl \
        llvm \
        libncurses5-dev \
        xz-utils \
        tk-dev \
        libxml2-dev \
        libxmlsec1-dev \
        libffi-dev \
        liblzma-dev \
        python3-apt \
        python3-dev \
        python3-venv \
        python3-pip \
        npm \
        rsyslog \
        jq \
        libnss-ldap libpam-ldap ldap-utils nscd openssh-client openssh-server libcurl4-openssl-dev libssl-dev \ 
        nginx \
        libldap2-dev libsasl2-dev \
        openssh-server \
        openssh-client

# =============================================================================
# Conda Installation and Configuration
# =============================================================================
ENV CONDA_ROOT=/opt/conda
ENV PATH=/opt/conda/bin:$PATH
ENV CONDA_AUTO_UPDATE_CONDA=false
ENV CONDA_YES=true

# Install x86 architecture Miniconda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda && \
    rm ~/miniconda.sh && \
    /opt/conda/bin/conda clean --tarballs --index-cache --packages --yes && \
    chmod -R 755 $CONDA_ROOT


# Add conda init to krong's bashrc
RUN cat << 'EOF' >> ${USER_HOME}/.bashrc

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/conda/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/conda/etc/profile.d/conda.sh" ]; then
        . "/opt/conda/etc/profile.d/conda.sh"
    else
        export PATH="/opt/conda/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

EOF


# Install conda bash completion
RUN git clone https://github.com/tartansandal/conda-bash-completion.git /opt/conda-bash-completion && \
    cd /opt/conda-bash-completion && \
    cp /opt/conda-bash-completion/conda /etc/bash_completion.d/

# Configure conda channels and accept Terms of Service
RUN conda config --system --add channels conda-forge && \
    conda config --system --set channel_priority strict && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

RUN source /opt/conda/bin/activate base && \
    python -m pip install numpy nvitop

# Install python-lsp-server for krong user
RUN su - krong -c "pipx install python-lsp-server[all]"

# =============================================================================
# SSH Configuration
# =============================================================================
# Copy SSH scripts for remote access
COPY infra/docker/ssh/start-ssh.sh /opt/ssh/start-ssh.sh
COPY infra/docker/ssh/ssh-config.sh /opt/ssh/ssh-config.sh
RUN chmod +x /opt/ssh/*.sh

# Run SSH configuration during build
RUN /opt/ssh/ssh-config.sh

# =============================================================================
# Code Server Settings Configuration
# =============================================================================
# Configure Code Server with optimized settings for development
RUN mkdir -p "${USER_HOME}/.config/code-server/data/Machine" && \
    chown -R krong:krong "${USER_HOME}/.config"
COPY --chown=krong:krong infra/docker/code-server/settings.json ${USER_HOME}/.config/code-server/data/Machine/settings.json

EXPOSE 1111

# =============================================================================
# Supervisord Configuration and Startup
# =============================================================================
ENV SUPERVISORD_USER=krong
ENV SUPERVISORD_PASS=krong

# Copy supervisord configuration
COPY infra/docker/supervisord/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create log directories for supervisord
RUN mkdir -p /var/log/supervisor /var/run/supervisord

# =============================================================================
# Final User Configuration
# =============================================================================
# # Add krong to docker group for Docker-in-Docker support
# RUN usermod -aG docker krong

# Ensure krong owns their home directory (parallel processing for speed)
# -H: include hidden files, -I: don't respect gitignore
RUN chown krong:krong ${USER_HOME} && \
    fdfind -H -I --type d -0 . ${USER_HOME} | xargs -0 -P$(nproc) -n500 chown krong:krong && \
    fdfind -H -I --type f -0 . ${USER_HOME} | xargs -0 -P$(nproc) -n500 chown krong:krong


# Set working directory
WORKDIR ${USER_HOME}

# Switch to krong user (supervisord will run as root, but default shell is krong)
# Note: supervisord needs root to manage services, so we don't switch USER here
# The user can switch to krong when entering the container

EXPOSE 9001 8080 8000 1111 8888
# Set supervisord as the default command
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
