# =============================================================================
# VLA Base Docker Image
# Optimized for A4000 GPU with CUDA 11.8 and Ubuntu 24.04
# Multi-architecture build support for M2 Mac (x86_64 emulation)
# =============================================================================

# Build configuration for x86 architecture on M2 Mac
# Usage: docker buildx build --platform linux/amd64 -f dockerfile.base -t base-image .

# =============================================================================
# Build Arguments - Configurable at build time
# =============================================================================
ARG CUDA_VERSION="11.8.0"           # CUDA version - stable for A4000 GPU
ARG CUDNN_VERSION="cudnn8"          # cuDNN version compatible with CUDA 11.8
ARG OS_VERSION="ubuntu22.04"        # Latest LTS Ubuntu version
ARG OS_VERSION_NO_DOT="ubuntu2204"  # Ubuntu version without dots
ARG CU_VERSION="cu118"              # CUDA version identifier

# =============================================================================
# Base Image - NVIDIA CUDA Development Environment
# =============================================================================
# Specify platform for x86 architecture build on M2 Mac
FROM --platform=linux/amd64 nvidia/cuda:${CUDA_VERSION}-${CUDNN_VERSION}-devel-${OS_VERSION} AS base

# Use bash for better script compatibility
SHELL ["/bin/bash", "-l", "-c"]

ENV TERM=xterm-256color
# =============================================================================
# Environment Setup
# =============================================================================
ARG CUDA_VERSION="11.8.0"
ARG CUDNN_VERSION="cudnn8"
ARG OS_VERSION="ubuntu22.04"
ARG OS_VERSION_NO_DOT="ubuntu2204"
ARG CU_VERSION="cu118"
# Optimized CUDA architectures for A4000 and modern GPUs
# 7.5: Volta (V100), 8.0: Ampere (A100), 8.6: Ampere (A4000), 8.9: Ada, 9.0: Hopper
ARG TORCH_CUDA_ARCH_LIST="7.5 8.0 8.6 8.9 9.0+PTX"

# System environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# NVIDIA driver capabilities for GPU access
ENV NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES},compute,display


# =============================================================================
# System Package Installation
# =============================================================================
# Update package list
RUN apt-get update -q

# System Base Tools
RUN apt-get install -q -y \
        software-properties-common \
        sudo \
        apt-transport-https \
        ca-certificates \
        gnupg \
        locales \
        language-pack-en \
        ncurses-base \
        ncurses-bin \
        ncurses-term \
        psmisc && \
    locale-gen en_US.UTF-8 && \
    locale-gen C.UTF-8 && \
    update-locale LANG=C.UTF-8 LC_ALL=C.UTF-8

# Locale 환경 변수 설정 (컨테이너 기본값)
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# =============================================================================
# User Configuration - krong user with sudo privileges
# =============================================================================
ARG USERNAME=krong
ARG USER_UID=1000
ARG USER_GID=1000

# Create user with sudo privileges (NOPASSWD)
# Ubuntu 24.04 has default 'ubuntu' user with UID 1000, remove it first
RUN existing_user=$(getent passwd ${USER_UID} | cut -d: -f1) && \
    if [ -n "$existing_user" ] && [ "$existing_user" != "${USERNAME}" ]; then \
        userdel -r "$existing_user" 2>/dev/null || true; \
    fi && \
    existing_group=$(getent group ${USER_GID} | cut -d: -f1) && \
    if [ -n "$existing_group" ] && [ "$existing_group" != "${USERNAME}" ]; then \
        groupdel "$existing_group" 2>/dev/null || true; \
    fi && \
    groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} && \
    echo "${USERNAME}:${USERNAME}" | chpasswd && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

# Set user home directory
ENV USER_HOME=/home/${USERNAME}

# Development & Build Tools
RUN apt-get install -q -y \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        git-lfs \
        nodejs \
        npm

# Networking Tools
RUN apt-get install -q -y \
        curl \
        wget \
        iputils-ping \
        net-tools \
        dnsutils \
        iproute2 \
        netcat-openbsd

# Monitoring & Performance Analysis Tools
RUN apt-get install -q -y \
        htop \
        nvtop \
        iotop \
        sysstat \
        strace \
        ltrace \
        lsof \
        ncdu \
        gdu

# Text Editors & Terminal Tools
RUN apt-get install -q -y \
        vim \
        tmux \
        zsh \
        bash-completion \
        fonts-powerline \
        tree \
        jq

# Search Tools
RUN apt-get install -q -y \
        silversearcher-ag \
        fzf \
        ripgrep \
        fd-find

# Python & Packaging
RUN apt-get install -q -y \
        pipx

# Media & Graphics Libraries
RUN apt-get install -q -y \
        ffmpeg \
        libgl1 \
        libsm6 \
        libxext6 \
        libglib2.0-0 \
        libxrender-dev

# Database Clients
RUN apt-get install -q -y \
        postgresql-client \
        redis-tools

# Messaging & Streaming
RUN apt-get install -q -y \
        librdkafka-dev \
        libsnappy-dev

# Utilities
RUN apt-get install -q -y \
        supervisor \
        rsync \
        tar \
        unzip

# Java
RUN apt-get install -q -y \
        default-jre \
        graphviz  


# =============================================================================
# Development Tools Installation
# =============================================================================
# Install uv (fast Python package manager) for krong user
RUN curl -LsSf https://astral.sh/uv/install.sh | su - krong -c "sh"
ENV PATH="${USER_HOME}/.local/bin:${PATH}"

# Install rclone for cloud storage management
RUN curl https://rclone.org/install.sh | bash

# # Install Docker CLI and Docker Compose for Docker-in-Docker support
